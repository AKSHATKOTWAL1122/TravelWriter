# StoryMaker backend settings. Copy this file to backend/.env and fill it in.
# Lookup order: shell environment variable, then backend/.env, then the default.
# Never put real secrets in this file; it's committed to git.

# Gemini API key (secret). Only needed for LLM calls; the app starts without it.
GEMINI_API_KEY=

# Model used for LLM calls.
# STORYMAKER_MODEL=gemini-2.5-flash

# Folder for everything the backend stores (database, media, story progress).
# STORYMAKER_DATA_DIR=data
